{
  "name": "bestest-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for Bestest's screened used-car inventory (Orange County, CA)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
