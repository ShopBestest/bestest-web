    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
